{
  "name": "trae-enterprise-validation-demo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev:web": "pnpm --filter web-admin dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run packages/shared/src apps/api/src tests/api",
    "test:api": "pnpm exec vitest run tests/api",
    "test:e2e": "pnpm exec playwright test",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.30",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.1.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.2"
  }
}
